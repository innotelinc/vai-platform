# ── Required ──────────────────────────────────────────────────────────────
# Strong secret used to sign dograh's JWT tokens
OSS_JWT_SECRET=change-me-to-a-long-random-string

# Must be reachable from INSIDE the n8n container (host LAN IP or public URL).
# For the innotel deployment the API is fronted by NPM at api.vai.innotel.us.
BACKEND_API_ENDPOINT=https://api.vai.innotel.us
PUBLIC_BASE_URL=https://vai.innotel.us

# Media-WebSocket auth. If the API is reachable over the public internet (e.g.
# ws.vai.innotel.us → :8000), set a random secret and enforce: the ARI manager mints
# an HMAC token per call and appends it via v() params, the handler verifies it
# (4401 on failure). Set the secret FIRST, watch logs for UNVERIFIED media
# socket, then flip ENFORCE=true.
TELEPHONY_WS_TOKEN_SECRET=
TELEPHONY_WS_TOKEN_ENFORCE=false

# ── dograh core ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redissecret
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── kokoro-fastapi (TTS) ──────────────────────────────────────────────────
# ghcr.io/remsky/kokoro-fastapi-cpu:latest (CPU) | :latest-gpu (GPU)
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest

# ── speaches (STT, faster-whisper) ────────────────────────────────────────
# The whisper model is chosen per-request via dograh's STT config (model =
# e.g. Systran/faster-distil-whisper-small.en), not set here.
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
SPEACHES_WHISPER_DEVICE=cpu      # cpu | cuda | auto
SPEACHES_WHISPER_COMPUTE_TYPE=int8

# ── OmniRoute (LLM gateway, OpenAI-compatible on 20128) ───────────────────
# MIT AI gateway (github.com/diegosouzapw/OmniRoute). model "auto" = zero-config
# routing across its free/connected providers with automatic failover.
# ⚠ free-tier cloud providers need internet; add a local Ollama as a provider
# in its dashboard (http://localhost:20128) for a fully-local LLM.
OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest
# Required secrets — replace with random values:
#   openssl rand -base64 48   (JWT_SECRET)
#   openssl rand -hex 32      (API_KEY_SECRET)
#   openssl rand -base64 16   (INITIAL_PASSWORD — first dashboard login)
#   openssl rand -base64 32   (OMNIROUTE_WS_BRIDGE_SECRET)
OMNIROUTE_JWT_SECRET=change-me-omniroute-jwt
OMNIROUTE_API_KEY_SECRET=change-me-omniroute-api-key
OMNIROUTE_INITIAL_PASSWORD=change-me-omniroute-admin
OMNIROUTE_WS_BRIDGE_SECRET=change-me-omniroute-ws
# API key the grader workflow sends as `Authorization: Bearer <key>` to the
# gateway on 20128. Set when the gateway enforces key auth (host 9Router does
# — grab the key from its dashboard → API Keys). Leave empty for the
# zero-config OmniRoute container (no auth needed).
OMNIROUTE_API_KEY=

# ── n8n ───────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_TIMEZONE=UTC
# Headless owner provisioning (first start) — used for CLI workflow import
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-in-env
N8N_OWNER_EMAIL=admin@localhost
N8N_OWNER_PASSWORD=admin123
# The stack startup imports and activates the Interview Grader workflow
# (n8n-import service). GRIST_DOC_ID is read by the workflow at runtime.

# ── n8n AI Assistant sandbox (self-hosted) ────────────────────────────────
# instance-ai module + n8n-sandbox execution + SearXNG search. The model is
# served by OmniRoute (OpenAI-compatible /v1 on 20128), model "auto".
N8N_ENABLED_MODULES=instance-ai
N8N_INSTANCE_AI_MODEL=auto
N8N_INSTANCE_AI_MODEL_URL=http://host.docker.internal:20128/v1
N8N_INSTANCE_AI_MODEL_API_KEY=omniroute
# Shared secret between n8n and the sandbox control plane (set strong values)
SANDBOX_API_KEYS=change-me-sandbox-api-key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-runner-registration-token
SANDBOX_API_RUNNER_API_KEY=change-me-runner-key
SEARXNG_SECRET=change-me-searxng-secret

# ── Grist ─────────────────────────────────────────────────────────────────
GRIST_ADMIN_EMAIL=admin@localhost
GRIST_ADMIN_PASSWORD=admin
# Grist document used by the scoring workflow. The merged stack bootstraps the
# default document on the deployment volume; set this when using another doc.
GRIST_DOC_ID=new~kcsms7E9nU5Mg43rWKjNsX

# ── SigNoz ───────────────────────────────────────────────────────────────
# Session-signing key for the unified signoz binary (UI + API). Set to a long
# random string; defaults to a generated value in the compose if unset.
SIGNOZ_JWT_SECRET=change-me-to-a-long-random-string

# Dograh deployment environment template (innotelinc/dograh — vai.innotel.us)
# Copy to .env and fill in real secrets. .env is gitignored — never commit it.
#
# Generate secrets with: openssl rand -hex 32

ENVIRONMENT=production

# Canonical public host/base URL for this install.
# SERVER_IP must be the server's real public IPv4, set only in the gitignored
# .env — the value below is a placeholder from a documentation range.
SERVER_IP=203.0.113.10
PUBLIC_HOST=vai.innotel.us
PUBLIC_BASE_URL=https://vai.innotel.us

# Backend API endpoint (public URL the backend uses to build webhook/embed links)
BACKEND_API_ENDPOINT=https://vai.innotel.us

# Public URL browsers use to fetch objects from MinIO (proxied by nginx)
MINIO_PUBLIC_ENDPOINT=https://vai.innotel.us

# TURN Server Configuration (time-limited credentials via TURN REST API)
# ENABLE_COTURN gates WebRTC TURN support (the stack runs coturn alongside api)
ENABLE_COTURN=true
TURN_HOST=vai.innotel.us
TURN_SECRET=CHANGE_ME
FORCE_TURN_RELAY=false

# ICE candidate filtering for WebRTC signaling (values: none, private, public,
# all). Defaults are auto-derived from ENVIRONMENT/SERVER_IP; set
# ICE_INBOUND_POLICY=none when clients test from the same LAN/NAT as the server
# (hairpin NAT may be unreliable) so the server can reach their private host
# candidates directly.

# JWT secret for OSS authentication
OSS_JWT_SECRET=CHANGE_ME

# PostgreSQL password. Baked into the postgres data volume on first init.
# Do NOT change after first start.
POSTGRES_PASSWORD=CHANGE_ME

# MinIO credentials (wired through docker-compose.override.yaml)
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# Redis password (wired through docker-compose.override.yaml)
REDIS_PASSWORD=CHANGE_ME

# Telemetry (set to false to disable)
ENABLE_TELEMETRY=false

# Number of uvicorn worker processes; nginx load-balances across them
FASTAPI_WORKERS=4

# ── n8n AI Assistant sandbox stack ─────────────────────────────────────────
# Secrets for the self-hosted n8n-sandbox services (sandbox-certs / sandbox-api
# / sandbox-runner-1) and SearXNG web search, wired into the n8n service by
# docker-compose.yaml. Generate with: openssl rand -hex 32
SANDBOX_API_KEYS=CHANGE_ME
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=CHANGE_ME
SANDBOX_API_RUNNER_API_KEY=CHANGE_ME
SEARXNG_SECRET=CHANGE_ME

# ── Local LLM + 9Router ─────────────────────────────────────────────────────
# Ollama and the in-repo 9Router gateway run inside the Compose network.
# The model is pulled once by the ollama-model init service.
OLLAMA_MODEL=llama3.2:1b
# Allow slow first-load CPU inference to finish before Ollama cancels it.
OLLAMA_LOAD_TIMEOUT=10m
OLLAMA_KEEP_ALIVE=10m
# N8N_INSTANCE_AI_MODEL_URL=http://nine-router:20128/v1
# N8N_INSTANCE_AI_MODEL=openai/llama3.2:1b
# NINE_ROUTER_IMAGE=python:3.13-alpine

# Grist document used by the n8n grader. Create the document/table once in
# Grist and replace this value with its real document ID.
GRIST_DOC_ID=interview-grader
GRIST_ADMIN_EMAIL=admin@localhost

# SigNoz self-hosted credentials and OTel endpoints.
SIGNOZ_POSTGRES_PASSWORD=CHANGE_ME
SIGNOZ_JWT_SECRET=CHANGE_ME
SIGNOZ_OTLP_ENDPOINT=http://signoz-otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=vai-api

# n8n workflow owner (change before a shared deployment).
N8N_OWNER_EMAIL=admin@localhost
N8N_OWNER_PASSWORD=CHANGE_ME
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGE_ME
N8N_EDITOR_BASE_URL=https://n8n.vai.innotel.us/
N8N_WEBHOOK_URL=https://n8n.vai.innotel.us/
N8N_HOST=n8n.vai.innotel.us
N8N_TIMEZONE=UTC
N8N_VERSION=2.35.4
# Docker-internal API origin used by n8n for transcript downloads. Leave this
# as http://api:8000 for the merged root Compose stack.
N8N_VAI_API_INTERNAL_URL=http://api:8000

# n8n AI Assistant sandbox and SearXNG credentials.
SANDBOX_API_KEYS=CHANGE_ME
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=CHANGE_ME
SANDBOX_API_RUNNER_API_KEY=CHANGE_ME
SEARXNG_SECRET=CHANGE_ME
